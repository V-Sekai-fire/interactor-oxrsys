{
  "jsonid": "input_profile",
  "controller_type": "oxrsys_controller",
  "input_bindingui_mode": "controller_handed",
  "input_source": {
    "/input/trigger": {
      "type": "trigger",
      "click": true,
      "value": true,
      "touch": true
    },
    "/input/grip": {
      "type": "trigger",
      "click": true,
      "value": true,
      "touch": true,
      "force": true
    },
    "/input/thumbstick": {
      "type": "joystick",
      "click": true,
      "touch": true
    },
    "/input/a": {
      "type": "button",
      "click": true,
      "touch": true
    },
    "/input/b": {
      "type": "button",
      "click": true,
      "touch": true
    },
    "/input/system": {
      "type": "button",
      "click": true
    },
    "/pose/raw": {
      "type": "pose"
    }
  },
  "default_bindings": [
    {
      "app_key": "openvr.component.vrcompositor",
      "binding_url": "vrcompositor_bindings_oxrsys_controller.json"
    }
  ],
  "compatibility_mode_controller_type": "knuckles"
}
